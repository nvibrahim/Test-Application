{
  "name": "@inspower/api",
  "version": "0.1.0",
  "private": true,
  "description": "Inspower Core API, background worker and command line.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "cli": "tsx src/cli/main.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@inquirer/prompts": "^8.7.5",
    "@inspower/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^8.0.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inspower/config-typescript": "workspace:*",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "oxlint": "^1.90.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.5"
  }
}
