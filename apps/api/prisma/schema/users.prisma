enum UserStatus {
  invited
  active
  disabled
  anonymised

  @@map("user_status")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  email              String
  emailNormalized    String     @map("email_normalized")
  fullName           String     @map("full_name")
  status             UserStatus @default(invited)
  passwordHash       String?    @map("password_hash")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastSignInAt       DateTime?  @map("last_sign_in_at") @db.Timestamptz(6)
  anonymisedAt       DateTime?  @map("anonymised_at") @db.Timestamptz(6)
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid
  updatedBy          String?    @map("updated_by") @db.Uuid

  preferences      UserPreferences?
  roles            UserRole[]
  locations        UserLocation[]
  invitations      UserInvitation[]
  emailChanges     EmailChangeToken[]
  sessions         Session[]
  passwordHistory  PasswordHistory[]
  passwordResets   PasswordResetToken[]
  twoFactor        UserTwoFactor?
  recoveryCodes    RecoveryCode[]
  trustedDevices   TrustedDevice[]
  stepUpGrants     StepUpGrant[]
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  featureFlagUsers FeatureFlagUser[]

  @@unique([organizationId, emailNormalized])
  @@index([organizationId, status])
  @@map("users")
}

model UserPreferences {
  userId            String   @id @map("user_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  theme             String   @default("system")
  density           String   @default("comfortable")
  timeZone          String?  @map("time_zone")
  dateFormat        String?  @map("date_format")
  defaultLocationId String?  @map("default_location_id") @db.Uuid
  sidebarCollapsed  Boolean  @default(false) @map("sidebar_collapsed")
  /// The two-step verification reminder banner: when it was last dismissed
  twoFactorReminderDismissedAt DateTime? @map("two_factor_reminder_dismissed_at") @db.Timestamptz(6)
  /// Which reminder emails (day 1, 7, 30) have gone, each once
  twoFactorRemindersSent Int[] @default([]) @map("two_factor_reminders_sent")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserRole {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  /// null means every location
  locationId     String?  @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([userId, roleId, locationId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model UserLocation {
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@map("user_locations")
}

model UserInvitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedBy      String?   @map("invited_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

model EmailChangeToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  newEmail       String    @map("new_email")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}
