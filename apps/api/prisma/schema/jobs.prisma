enum JobRunStatus {
  queued
  running
  completed
  failed
  cancelled

  @@map("job_run_status")
}

model JobRun {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  queue          String
  name           String
  jobId          String       @map("job_id")
  status         JobRunStatus @default(queued)
  attempts       Int          @default(0)
  inputSummary   Json?        @map("input_summary")
  result         Json?
  error          String?
  startedBy      String?      @map("started_by") @db.Uuid
  queuedAt       DateTime     @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@unique([queue, jobId])
  @@index([organizationId, queuedAt(sort: Desc)])
  @@index([status])
  @@map("job_runs")
}

model ScheduledJob {
  key            String    @id
  organizationId String    @map("organization_id") @db.Uuid
  isPaused       Boolean   @default(false) @map("is_paused")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastResult     String?   @map("last_result")
  lastError      String?   @map("last_error")
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("scheduled_jobs")
}

/// Written in the same transaction as the change it announces; the worker publishes it.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  channels       String[]
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
