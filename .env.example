# Copy to .env and replace every change-me. The API refuses to start with placeholder keys outside local dev.
NODE_ENV=development
APP_NAME=Inspower

# Web and API addresses
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
COOKIE_SECURE=false
TRUST_PROXY=loopback

# Data stores (Docker Compose publishes these ports)
DATABASE_URL=postgresql://inspower:inspower@127.0.0.1:5432/inspower?schema=public
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=inspower

# Keys: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=change-me
BACKUP_ENCRYPTION_KEY=change-me

# Mail (Mailpit locally; real SMTP can also be set in Settings -> Email)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Inspower <no-reply@localhost>"

# Logging
LOG_LEVEL=info
